    "test:watch": "vitest",
    "onboard": "tsx src/cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "optionalDependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
