{
  "name": "cais-source-onboarding",
  "version": "0.1.0",
  "private": true,
  "description": "CAIS Source Onboarding Pipeline — automatic classification, discovery, auto-registration and a free Stage-0 filter for new scrape sources.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
