# CAIS Source Onboarding — environment configuration
# Copy to .env and fill in. Never commit real secrets.

# Supabase (service-role key only used server-side by the onboarding jobs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (existing Claude API scorer — the Stage-0 filter runs *before* this)
ANTHROPIC_API_KEY=

# Classifier tuning (see spec §3 / §8). 0.8 is the suggested starting threshold.
APPROVAL_THRESHOLD=0.8

# Stage-0 filter minimum bar (see spec §6). Listings scoring below this never hit the API.
STAGE_ZERO_MINIMUM_BAR=2
